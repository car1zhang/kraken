/kraken
.DS_Store
xcuserdata/
/ios/build/
# ship-testflight.sh keeps archives and .ipas in a mktemp dir outside the repo,
# so these only appear when someone runs xcodebuild by hand from ios/. They are
# hundreds of MB of build output and must never be committed.
*.xcarchive/
*.ipa
/.claude/settings.json
/.playwright-mcp/
# lint_svg.py gets imported as a module by tests and reviewers, which drops
# bytecode next to the skill assets. go:embed skips _-prefixed names so it can
# never reach the binary, but it should not reach a commit either.
__pycache__/
*.pyc
# The React board's dependencies and build output. dist/ is generated by
# `make build` (the web-assets target) rather than committed, so it is
# deliberately ignored — with the consequence that a bare `go build` on a
# clean clone fails until assets exist, since web/embed.go's go:embed cannot
# embed an empty directory. `make build` is the supported entrypoint.
/web/_ui/node_modules/
/web/_ui/dist/
