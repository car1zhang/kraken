#compdef k kraken

_k() {
    local -a subcmds
    subcmds=(
        'ls:list live claudes across tmux'
        'v:live viewer TUI (vim keys, enter/click open, b branch, dd kill, t grouping)'
        'o:jump to an agent or shell pane (focus ghostty window + pane)'
        'b:branch (fork) a session into a split'
        's:send a message to a claude'
        'r:read back last n output blocks'
        'k:kill a pane (claude or shell)'
        'n:new shell window, optionally running a command'
        'c:new named claude window with a prompt'
        'account:rotation status, or switch/pin the main Claude login (auto|<slug>)'
        'questions:cell-side verb — read/write a job'"'"'s open doc questions via kraken serve'
        'goals:cell-side verb — re-read carl'"'"'s current week/day goals via kraken serve (read-only)'
        'feedback:cell-side verb — read/mark-addressed a job'"'"'s artifact feedback via kraken serve'
        'watchlist:cell-side verb — read/write the dream loop'"'"'s watch overlay on the knowledge graph, via kraken serve'
        'load:cell-side verb — record what a blocked job costs carl and buys, via kraken serve'
        'graph:cell-side verb — read/write the knowledge graph via kraken serve'
        'slack:iris-side verb — read/ack the Slack intake inbox via kraken serve'
        'job:iris-side verb — list/read jobs and write a draft via kraken serve'
        'mine:the dream pass'"'"' mechanical read of claude'"'"'s transcripts (local files, no serve)'
        'serve:the one long-lived kraken process — scheduler + web UI/API, sqlite-backed'
        'import:one-shot sqlite-migration cutover (human-run once per machine)'
        'cutover:one-shot rename of preserved artifacts onto <slug>-<id> (human-run once per machine)'
        'update:self-update — fast-forward, rebuild, reinstall, restart the launchd job'
        'ship-ios:build the iOS app and upload it to TestFlight (needs ASC_KEY_ID/ASC_ISSUER_ID)'
        'help:show help'
    )

    if (( CURRENT == 2 )); then
        _describe 'command' subcmds
        return
    fi

    case ${words[2]} in
        o|b|s|r|k)
            if (( CURRENT == 3 )); then
                local -a peers
                local value desc
                while IFS=$'\t' read -r value desc; do
                    peers+=("${value}:${desc}")
                done < <(command k _complete 2>/dev/null)
                _describe -V -t peers 'session' peers -M 'm:{-_ }={-_ } l:|=* r:|=*'
            fi
            ;;
        account)
            if (( CURRENT == 3 )); then
                local -a targets
                targets=(auto)
                # glob-qualified: (N) nullglob (no error on zero matches),
                # (/) directories only — cooldowns.json and the
                # .rotation-inflight journal file live alongside the slot
                # dirs in the same pool dir and must not show up as targets
                # — (:t) takes just the basename of each match.
                targets+=(${CLAUDE_POOL_DIR:-$HOME/.claude-pool}/*(N/:t))
                _describe -t targets 'target' targets
            fi
            ;;
        questions)
            if (( CURRENT == 3 )); then
                local -a ops
                ops=(
                    'get:print open doc questions as JSON'
                    'set:bulk-replace from a JSON array on stdin'
                    'add:add one question from a JSON object on stdin'
                    'update:update one question from a JSON object on stdin'
                    'remove:remove one question by qid'
                )
                _describe -t ops 'op' ops
            fi
            # <slug> completion (word 4) is intentionally not offered: job
            # identity lives only in kraken.db now (Q14/store-only jobs), and
            # there is no cheap store-backed completion source the way
            # 'k _complete' (tmux/ps discovery) or the pool dir listing
            # (account, above) are.
            ;;
        goals)
            if (( CURRENT == 3 )); then
                local -a ops
                # One op, and it stays one: the goals are carl's, written from
                # the board, so the cell side is read-only by construction (see
                # cmd_goals.go).
                ops=(
                    'get:print this week'"'"'s and today'"'"'s goals as JSON'
                )
                _describe -t ops 'op' ops
            fi
            # word 4 is the OPTIONAL <slug>; no completion is offered for it,
            # for the reason spelled out under questions) above: job identity
            # lives only in kraken.db, with no cheap store-backed completion
            # source.
            ;;
        update)
            local -a updflags
            updflags=(
                '--force:reinstall + restart even when already up to date'
                '--dry-run:report the ahead/behind state and change nothing'
                '--test:run go test ./... after the build, before installing'
            )
            _describe -t flags 'flag' updflags
            ;;
        ship-ios)
            # --detached is deliberately not offered: it is the board's
            # spawn convention, not something a human ever types. Neither is
            # the script's --allow-provisioning-updates, which this verb does
            # not accept at all (it would mutate the Apple developer account).
            local -a shipflags
            shipflags=(
                '--dry-run:preflight and print the plan; build nothing, upload nothing'
            )
            _describe -t flags 'flag' shipflags
            ;;
        feedback)
            if (( CURRENT == 3 )); then
                local -a ops
                ops=(
                    'get:print open+addressed feedback as JSON'
                    'sweep:print every job'"'"'s feedback in a time window as JSON (no slug)'
                    'addressed:mark one feedback entry addressed'
                )
                _describe -t ops 'op' ops
            elif [[ $words[3] == addressed ]]; then
                # --clear is the only flag either verb takes: it posts the
                # API's explicitly-empty addressed form, reopening the entry.
                local -a fbflags
                fbflags=(
                    '--clear:clear the addressed note and reopen the entry'
                )
                _describe -t flags 'flag' fbflags
            elif [[ $words[3] == sweep ]]; then
                local -a swflags
                swflags=(
                    '--since:window floor in unix millis (default: 24h ago)'
                )
                _describe -t flags 'flag' swflags
            fi
            ;;
        watchlist)
            if (( CURRENT == 3 )); then
                local -a ops
                ops=(
                    'get:print watch items as JSON (optional state filter)'
                    'add:watch one observation from a JSON object on stdin (folds when the graph already states it)'
                    'update:update one item'"'"'s overlay fields from a JSON object on stdin'
                    'remove:unwatch one item by edge id (the fact stays in the graph)'
                )
                _describe -t ops 'op' ops
            elif [[ $words[3] == get && CURRENT == 4 ]]; then
                # the state filter's whole value set — the same three
                # store/watch.go documents; omitting it means every item.
                local -a states
                states=(
                    'watching:still being tracked'
                    'shipped:folded into a change already'
                    'declined:looked at and dropped'
                )
                _describe -t states 'state' states
            fi
            ;;
        load)
            if (( CURRENT == 3 )); then
                local -a ops
                ops=(
                    'get:print the job'"'"'s unblock/scope estimate as JSON'
                    'set:write the estimate (--unblock and --scope, both 1-10)'
                    'clear:remove the estimate'
                )
                _describe -t ops 'op' ops
            elif [[ $words[3] == set ]] && (( CURRENT > 4 )); then
                # CURRENT > 4, not just the `set` test: word 4 is the <slug>
                # positional, and offering flags there would suggest a slug is
                # optional when every op requires one.
                local -a loadflags
                loadflags=(
                    '--unblock:1-10 — effort carl spends to unblock this job'
                    '--scope:1-10 — size of the claude work that reply unblocks'
                    '--note:one-line rationale (capped at 200 runes server-side)'
                )
                _describe -t flags 'flag' loadflags
            fi
            # <slug> completion is intentionally not offered, for the reason
            # spelled out under questions) above: job identity lives only in
            # kraken.db, with no cheap store-backed completion source.
            ;;
        graph)
            if (( CURRENT == 3 )); then
                local -a ops
                ops=(
                    'pending:print the episodes still awaiting extraction, as JSON'
                    'add:write one extraction turn (--json <path>, or stdin)'
                    'done:close one episode, including one nothing was extracted from'
                    'search:print the facts matching a query, as triples'
                    'get:dereference [F#]/E# handles to the full fact or episode, as JSON'
                    'stats:print the node/edge/episode counts, as JSON'
                )
                _describe -t ops 'op' ops
            elif (( CURRENT >= 4 )) && [[ $words[3] == add ]]; then
                local -a gflags
                gflags=(
                    '--episode:the episode id this extraction turn came from'
                    '--json:path to the add payload (stdin when omitted)'
                )
                _describe -t flags 'flag' gflags
                # --json's value is a real path, so offer files alongside.
                [[ $words[CURRENT-1] == --json ]] && _files
            elif (( CURRENT == 4 )) && [[ $words[3] == pending ]]; then
                # search's word 4 is its <query> positional and done's is an
                # episode id — so --limit is only offered where it is
                # actually the next word.
                local -a gflags
                gflags=(
                    '--limit:how many episodes to print (default 20, capped at 200)'
                )
                _describe -t flags 'flag' gflags
            elif (( CURRENT == 5 )) && [[ $words[3] == search ]]; then
                local -a gflags
                gflags=(
                    '--limit:how many facts to return (default 20, capped at 200)'
                )
                _describe -t flags 'flag' gflags
            fi
            ;;
        slack)
            if (( CURRENT == 3 )); then
                local -a ops
                ops=(
                    'inbox:print every unacked Slack message as JSON (arrival order)'
                    'status:print whether Slack is configured, the last poll, and the backlog'
                    'ack:retire a batch of messages with a disposition'
                )
                _describe -t ops 'op' ops
            elif [[ $words[3] == ack ]]; then
                # both flags are REQUIRED, so both are offered from word 4 on
                # — unlike `load set`, this op takes no positional at all, and
                # withholding them until word 5 would suggest one exists.
                local -a ackflags
                ackflags=(
                    '--ids:comma-separated inbox ids from `k slack inbox`'
                    '--disposition:what happened — drafted:<slug>, edited:<slug>, ignored:<reason>'
                )
                _describe -t flags 'flag' ackflags
            fi
            ;;
        job)
            if (( CURRENT == 3 )); then
                local -a ops
                ops=(
                    'list:print every active job'"'"'s slug, state and one-line summary as JSON'
                    'raw:print one job'"'"'s whole text plus its mtime lock token'
                    'draft:create or amend a DRAFT from the job text on stdin'
                )
                _describe -t ops 'op' ops
            elif [[ $words[3] == draft ]] && (( CURRENT > 4 )); then
                # CURRENT > 4, not just the `draft` test: word 4 is the <slug>
                # positional, and offering the flag there would suggest a slug
                # is optional when it is not.
                local -a draftflags
                draftflags=(
                    '--mtime:the lock token `k job raw <slug>` printed (omit on a create)'
                )
                _describe -t flags 'flag' draftflags
            fi
            # <slug> completion is intentionally not offered, for the reason
            # spelled out under questions) above: job identity lives only in
            # kraken.db, with no cheap store-backed completion source.
            ;;
        mine)
            if (( CURRENT == 3 )); then
                local -a ops
                ops=(
                    'digest:one mechanical digest per transcript in the window, as JSON'
                    'reduce:print ONE transcript cut to its decision-relevant slice'
                )
                _describe -t ops 'op' ops
            elif (( CURRENT == 4 )); then
                local -a mflags
                mflags=(
                    '--since:window floor in unix millis (default: 24h ago)'
                )
                _describe -t flags 'flag' mflags
                # reduce's positional is a transcript path; digest takes none.
                [[ $words[3] == reduce ]] && _files
            fi
            ;;
    esac
}

_k "$@"
