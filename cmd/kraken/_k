#compdef k kraken

_k() {
    local -a subcmds
    subcmds=(
        'ls:list live claudes across tmux'
        'v:live viewer TUI (vim keys, enter/click open, b branch, dd kill, t grouping)'
        'o:jump to an agent or shell pane (focus ghostty window + pane)'
        'b:branch (fork) a session into a split'
        's:send a message to a claude'
        'r:read back last n output blocks'
        'k:kill a pane (claude or shell)'
        'n:new shell window, optionally running a command'
        'c:new named claude window with a prompt'
        'account:rotation status, or switch/pin the main Claude login (auto|<slug>)'
        'questions:cell-side verb — read/write a job'"'"'s open doc questions via kraken serve'
        'feedback:cell-side verb — read/mark-addressed a job'"'"'s artifact feedback via kraken serve'
        'watchlist:cell-side verb — read/write the dream loop'"'"'s global watchlist via kraken serve'
        'mine:the dream pass'"'"' mechanical read of claude'"'"'s transcripts (local files, no serve)'
        'serve:the one long-lived kraken process — scheduler + web UI/API, sqlite-backed'
        'import:one-shot sqlite-migration cutover (human-run once per machine)'
        'update:self-update — fast-forward, rebuild, reinstall, restart the launchd job'
        'ship-ios:build the iOS app and upload it to TestFlight (needs ASC_KEY_ID/ASC_ISSUER_ID)'
        'help:show help'
    )

    if (( CURRENT == 2 )); then
        _describe 'command' subcmds
        return
    fi

    case ${words[2]} in
        o|b|s|r|k)
            if (( CURRENT == 3 )); then
                local -a peers
                local value desc
                while IFS=$'\t' read -r value desc; do
                    peers+=("${value}:${desc}")
                done < <(command k _complete 2>/dev/null)
                _describe -V -t peers 'session' peers -M 'm:{-_ }={-_ } l:|=* r:|=*'
            fi
            ;;
        account)
            if (( CURRENT == 3 )); then
                local -a targets
                targets=(auto)
                # glob-qualified: (N) nullglob (no error on zero matches),
                # (/) directories only — cooldowns.json and the
                # .rotation-inflight journal file live alongside the slot
                # dirs in the same pool dir and must not show up as targets
                # — (:t) takes just the basename of each match.
                targets+=(${CLAUDE_POOL_DIR:-$HOME/.claude-pool}/*(N/:t))
                _describe -t targets 'target' targets
            fi
            ;;
        questions)
            if (( CURRENT == 3 )); then
                local -a ops
                ops=(
                    'get:print open doc questions as JSON'
                    'set:bulk-replace from a JSON array on stdin'
                    'add:add one question from a JSON object on stdin'
                    'update:update one question from a JSON object on stdin'
                    'remove:remove one question by qid'
                )
                _describe -t ops 'op' ops
            fi
            # <slug> completion (word 4) is intentionally not offered: job
            # identity lives only in kraken.db now (Q14/store-only jobs), and
            # there is no cheap store-backed completion source the way
            # 'k _complete' (tmux/ps discovery) or the pool dir listing
            # (account, above) are.
            ;;
        update)
            local -a updflags
            updflags=(
                '--force:reinstall + restart even when already up to date'
                '--dry-run:report the ahead/behind state and change nothing'
                '--test:run go test ./... after the build, before installing'
            )
            _describe -t flags 'flag' updflags
            ;;
        ship-ios)
            # --detached is deliberately not offered: it is the board's
            # spawn convention, not something a human ever types. Neither is
            # the script's --allow-provisioning-updates, which this verb does
            # not accept at all (it would mutate the Apple developer account).
            local -a shipflags
            shipflags=(
                '--dry-run:preflight and print the plan; build nothing, upload nothing'
            )
            _describe -t flags 'flag' shipflags
            ;;
        feedback)
            if (( CURRENT == 3 )); then
                local -a ops
                ops=(
                    'get:print open+addressed feedback as JSON'
                    'sweep:print every job'"'"'s feedback in a time window as JSON (no slug)'
                    'addressed:mark one feedback entry addressed'
                )
                _describe -t ops 'op' ops
            elif [[ $words[3] == addressed ]]; then
                # --clear is the only flag either verb takes: it posts the
                # API's explicitly-empty addressed form, reopening the entry.
                local -a fbflags
                fbflags=(
                    '--clear:clear the addressed note and reopen the entry'
                )
                _describe -t flags 'flag' fbflags
            elif [[ $words[3] == sweep ]]; then
                local -a swflags
                swflags=(
                    '--since:window floor in unix millis (default: 24h ago)'
                )
                _describe -t flags 'flag' swflags
            fi
            ;;
        watchlist)
            if (( CURRENT == 3 )); then
                local -a ops
                ops=(
                    'get:print watchlist rows as JSON (optional state filter)'
                    'add:add one observation from a JSON object on stdin'
                    'update:update one observation from a JSON object on stdin'
                    'remove:remove one row by id'
                )
                _describe -t ops 'op' ops
            elif [[ $words[3] == get && CURRENT == 4 ]]; then
                # the state filter's whole value set — the same three
                # store/watchlist.go documents; omitting it means every row.
                local -a states
                states=(
                    'watching:still being tracked'
                    'shipped:folded into a change already'
                    'declined:looked at and dropped'
                )
                _describe -t states 'state' states
            fi
            ;;
        mine)
            if (( CURRENT == 3 )); then
                local -a ops
                ops=(
                    'digest:one mechanical digest per transcript in the window, as JSON'
                    'reduce:print ONE transcript cut to its decision-relevant slice'
                )
                _describe -t ops 'op' ops
            elif (( CURRENT == 4 )); then
                local -a mflags
                mflags=(
                    '--since:window floor in unix millis (default: 24h ago)'
                )
                _describe -t flags 'flag' mflags
                # reduce's positional is a transcript path; digest takes none.
                [[ $words[3] == reduce ]] && _files
            fi
            ;;
    esac
}

_k "$@"
